<!--
 TASK-48: a neutral, complete widget view for an empty weather database.
 It deliberately carries none of the raw demo values that the regular widget
 layouts use as XML defaults, so inflating it can never show placeholder data
 while there is no weather card to render.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_nodata_maincontainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView android:id="@+id/widget_nodata_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textAlignment="center"
        android:ellipsize="end"
        android:maxLines="4"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:textColor="@color/colorTextWidget"
        android:textSize="@dimen/widget_textsize_medium"
        android:text="@string/error_no_data" />

</RelativeLayout>
