<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:background="?attr/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true">

    <TextView android:id="@+id/legend_title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="18sp"
              android:textStyle="bold"
              android:textColor="?attr/colorText"
              android:gravity="center"
              android:layout_marginTop="3dp"
              android:text="@string/legend_title"/>

    <View android:id="@+id/legend_solid_bar"
          android:layout_width="match_parent"
          android:layout_height="3dip"
          android:layout_below="@id/legend_title"
          android:background="?attr/colorTextDark"/>

    <LinearLayout android:id="@+id/legend_button_line"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:layout_marginTop="3dip"
                  android:layout_alignParentBottom="true">

        <Button android:id="@+id/legend_button_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:nextFocusUp="@id/legend_scrollview"
                android:textSize="@dimen/fcmain_textsize_medium"
                android:textColor="?attr/colorText"
                android:text="@string/alertdialog_ok"/>
    </LinearLayout>

    <ScrollView android:id="@+id/legend_scrollview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nextFocusDown="@id/legend_button_back"
                android:nextFocusForward="@id/legend_button_back"
                android:fillViewport="true"
                android:layout_below="@id/legend_solid_bar"
                android:layout_above="@id/legend_button_line">

        <LinearLayout android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="vertical">

            <TextView android:id="@+id/legend_sample_caption"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:textSize="@dimen/fcmain_textsize_medium"
                      android:textColor="?attr/colorText"
                      android:gravity="center"
                      android:layout_marginTop="6dp"
                      android:layout_marginBottom="4dp"
                      android:text="@string/legend_sample_caption"/>

            <ImageView android:id="@+id/legend_sample"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:adjustViewBounds="true"
                       android:scaleType="fitCenter"
                       android:layout_marginLeft="6dp"
                       android:layout_marginRight="6dp"
                       android:contentDescription="@string/legend_sample_caption"/>

            <LinearLayout android:id="@+id/legend_items"
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:orientation="vertical"
                          android:layout_marginTop="8dp"/>

            <TextView android:id="@+id/legend_hint"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:textSize="@dimen/fcmain_textsize_medium"
                      android:textColor="?attr/colorText"
                      android:gravity="center"
                      android:layout_marginTop="12dp"
                      android:layout_marginBottom="8dp"
                      android:layout_marginLeft="6dp"
                      android:layout_marginRight="6dp"
                      android:text="@string/legend_hint"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
