<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TASK-64: dedicated legend entry in the warning-map action bar. -->
    <item android:id="@+id/map_legend"
          android:title="@string/map_legend_title"
          android:icon="?attr/ic_map"
          android:showAsAction="always"
          android:orderInCategory="1">
    </item>

    <!-- TASK-65: dedicated per-layer selector for the vector warning map. -->
    <item android:id="@+id/map_layers"
          android:title="@string/map_layers_title"
          android:icon="?attr/ic_filter_list"
          android:showAsAction="always"
          android:orderInCategory="2">
    </item>

    <!-- Kept for the legacy static map; hidden in vector mode where map_layers takes over. -->
    <item android:id="@+id/hide_rain"
          android:title="@string/hide_rain"
          android:icon="?attr/ic_filter"
          android:showAsAction="always"
          android:orderInCategory="3">
    </item>

    <item android:id="@+id/menu_refresh"
        android:title="@string/update_button"
        android:icon="?attr/ic_refresh"
        android:showAsAction="ifRoom"
        android:orderInCategory="4">
    </item>

</menu>