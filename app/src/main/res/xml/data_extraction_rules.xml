 Rationale (devices running Android 12 or higher):
 The same two private data sets are excluded for both transfer types:
 - files/logs.txt: internal diagnostic log written by PrivateLog;
 - shared_prefs: all default SharedPreferences (saved station coordinates,
   Gadgetbridge package name, custom weather server URL and similar settings).
 Cloud backup additionally requires client-side encryption capabilities.
 Excluding the whole sharedpref directory also covers preference files added
 later, so no preference can be backed up without an explicit rule.
-->

<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="logs.txt" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs.txt" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
    <!--
      Android 16 QPR2+ cross-platform transfers are a separate mode and are
      fully enabled when not configured. Apply the same exclusions there.
    -->
    <cross-platform-transfer platform="ios">
        <exclude domain="file" path="logs.txt" />
        <exclude domain="sharedpref" path="." />
    </cross-platform-transfer>
</data-extraction-rules>
